{
  "module": {
    "name": "web_engine",
    "type": "har",
    "deviceTypes": [
      "tablet",
      "2in1"
    ],
    "requestPermissions": [
      // ===== 基础权限（声明即生效，直接可用） =====
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.RUNNING_LOCK" },
      { "name": "ohos.permission.PREPARE_APP_TERMINATE" },
      { "name": "ohos.permission.FILE_ACCESS_PERSIST" },
      { "name": "ohos.permission.READ_PASTEBOARD",
        "reason": "$string:access_pasteboard",
        "usedScene": { "abilities": ["FormAbility"], "when": "always" } },

      // ===== JIT 权限（★模板关键：应用内拉起 Java/JS 引擎需要） =====
      // system_basic 级，需 ACL 邮件向华为申请（bundleName + 用途"内置引擎 JIT"）；
      // 获批后生效；未获批时形态 A（终端启动）开发不受影响，形态 B 需 -Xint 降级
      { "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY" },

      // ===== 按需权限（用到再启用：取消注释 + ACL 申请；未获批先保持注释，否则签名不过） =====
      // { "name": "ohos.permission.SYSTEM_FLOAT_WINDOW" },                 // 全局悬浮窗
      // { "name": "ohos.permission.ACCESS_CERT_MANAGER" },                 // 证书/凭据管理
      // { "name": "ohos.permission.PRINT" },                               // 打印
      // { "name": "ohos.permission.ACCESS_BIOMETRIC" },                    // 生物识别
      // { "name": "ohos.permission.PRIVACY_WINDOW" },                      // 隐私窗口(禁截屏)
      // { "name": "ohos.permission.WINDOW_TOPMOST" },                      // 窗口置顶
      // { "name": "ohos.permission.READ_WRITE_DOWNLOAD_DIRECTORY",         // 公共下载目录
      //   "reason": "$string:download_dir",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.READ_WRITE_DOCUMENTS_DIRECTORY",        // 公共文档目录
      //   "reason": "$string:documents_dir",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.READ_WRITE_DESKTOP_DIRECTORY",          // 公共桌面目录
      //   "reason": "$string:desktop_dir",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.LOCATION",                              // 定位（含以下两族）
      //   "reason": "$string:location",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.APPROXIMATELY_LOCATION", "reason": "$string:location",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.LOCATION_IN_BACKGROUND", "reason": "$string:location",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.MICROPHONE",                            // 麦克风
      //   "reason": "$string:microphone",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.CAMERA",                                // 相机
      //   "reason": "$string:camera",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.ACCESS_BLUETOOTH",                      // 蓝牙
      //   "reason": "$string:access_bluetooth",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
      // { "name": "ohos.permission.CUSTOM_SCREEN_CAPTURE",                 // 屏幕采集
      //   "reason": "$string:screen_capture",
      //   "usedScene": { "abilities": ["FormAbility"], "when": "always" } },
    ],
    "definePermissions": [
      {
        "name": "ohos.permission.kernel.ALLOW_WRITABLE_CODE_MEMORY"
      }
    ]
  }
}
